{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "自然拾光记账",
  "version": "0.1.0",
  "identifier": "com.zrsj.bookkeeper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "自然拾光记账",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "brand/installer-sidebar.bmp",
        "headerImage": "brand/installer-header.bmp"
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "resources": [
      "resources/tesseract/**/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCN0IxNTY4NDM1RjkwODEKUldTQmtGOURhQlY3VzV1TERlUWROVktBNUJ5ZkZNb2hqdmZzRkUyQjAyMllCOWE2MTkxbHc1cmMK",
      "endpoints": []
    }
  }
}
